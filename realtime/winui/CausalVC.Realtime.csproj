<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows front end of the realtime voice changer (WinUI 3, acrylic). It drives the same
       Python engine as the Linux COSMIC front end in ../ui, over loopback TCP (see
       ../docs/engine-protocol.md). Build: dotnet publish -c Release -r win-x64 -o out -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>CausalVC.Realtime</RootNamespace>
    <AssemblyName>CausalVC.Realtime</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged, with the Windows App SDK runtime copied beside the exe: nothing to install. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- The .NET runtime goes beside the exe as well: the SDK run-realtime.bat installs lives in
         .dotnet, which the exe would not look in, and the exe then runs on any PC. -->
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- An unpackaged publish leaves out the app's own resources (CausalVC.Realtime.pri and the
       compiled XAML), without which the window crashes on start: copy them from the build output. -->
  <Target Name="PublishAppXamlResources" AfterTargets="Publish">
    <ItemGroup>
      <AppXamlResource Include="$(OutDir)$(AssemblyName).pri;$(OutDir)*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(AppXamlResource)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
