<?xml version="1.0" encoding="utf-8"?>
<!-- The package sources for the Windows windows (realtime/winui, training/winui): nuget.org only.
     <clear/> drops sources a machine's own NuGet settings add, such as Visual Studio's offline
     folder (C:\Program Files (x86)\Microsoft SDKs\NuGetPackages\), whose absence otherwise
     fails the restore with NU1301 although every package comes from nuget.org. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
