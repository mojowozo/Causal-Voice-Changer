<?xml version="1.0" encoding="utf-8"?>
<!-- The window: a desktop acrylic backdrop under a title bar and a navigation pane, the page, and a
     control bar in in-app acrylic floating over the page's bottom (pages scroll under it).
     Mirrors the COSMIC front end in ../ui: same pages, same control bar. -->
<Window
    x:Class="CausalVC.Training.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CausalVC Trainer">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="48" Padding="16,0,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="TitleBarIcon" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" Text="CausalVC Trainer" />
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1"
                        PaneDisplayMode="Auto" CompactModeThresholdWidth="0" ExpandedModeThresholdWidth="900"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        IsTitleBarAutoPaddingEnabled="False" OpenPaneLength="220"
                        SelectionChanged="OnNavigationChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavVoice" Content="New voice" Tag="Voice">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE77B;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Builds" Tag="Builds">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8FD;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Log" Tag="Log">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE756;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="About" Tag="About">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="PageTitle" Margin="24,20,24,12" Style="{StaticResource TitleTextBlockStyle}" />

                <!-- The page; its bottom padding leaves room for the control bar over it. -->
                <ContentControl x:Name="PageHost" Grid.Row="1"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

                <!-- While the trainer starts, or when it is unavailable. -->
                <Grid x:Name="ConnectionView" Grid.Row="1" Visibility="Collapsed">
                    <StackPanel MaxWidth="720" Padding="24" Spacing="12"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressRing x:Name="ConnectionRing" Width="40" Height="40" IsActive="True" />
                        <FontIcon x:Name="ConnectionErrorIcon" Glyph="&#xEA39;" FontSize="48" Visibility="Collapsed"
                                  Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        <TextBlock x:Name="ConnectionTitle" HorizontalAlignment="Center" TextAlignment="Center"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="ConnectionDetail" HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" Style="{StaticResource SecondaryCaptionStyle}" />
                        <Border x:Name="ConnectionReasonCard" Style="{StaticResource SettingsCardStyle}"
                                Padding="12" Visibility="Collapsed">
                            <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Auto">
                                <TextBlock x:Name="ConnectionReason" FontFamily="{StaticResource MonoFont}"
                                           FontSize="12" IsTextSelectionEnabled="True" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Grid>

                <Border x:Name="ControlBarHost" Grid.Row="1" Style="{StaticResource ControlBarStyle}"
                        Margin="16,0,16,16" VerticalAlignment="Bottom" MaxWidth="1100" Visibility="Collapsed" />

                <!-- Toasts, above the control bar. -->
                <StackPanel x:Name="Toasts" Grid.Row="1" Spacing="8" Width="380"
                            Margin="0,0,24,120" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
